{
  "components": {
    "headers": {
      "RequestId": {
        "description": "ID korelasi stabil untuk respons dan pelacakan dukungan.",
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "description": "Kunci unik 8-128 karakter untuk mendeduplikasi mutation yang aman diulang.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
          "type": "string"
        }
      }
    },
    "schemas": {
      "ApiErrorDetailDto": {
        "properties": {
          "field": {
            "example": "title",
            "type": "string"
          },
          "reason": {
            "enum": ["invalid_value", "length_out_of_range", "must_be_string", "unknown_field"],
            "example": "length_out_of_range",
            "type": "string"
          }
        },
        "required": ["field", "reason"],
        "type": "object"
      },
      "ApiErrorDto": {
        "properties": {
          "code": {
            "enum": [
              "BAD_REQUEST",
              "CONFLICT",
              "FORBIDDEN",
              "INTERNAL_ERROR",
              "INVALID_IDEMPOTENCY_KEY",
              "NOT_FOUND",
              "RATE_LIMITED",
              "UNAUTHORIZED",
              "VALIDATION_FAILED"
            ],
            "example": "VALIDATION_FAILED",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetailDto"
            },
            "type": "array"
          },
          "message": {
            "example": "Periksa kembali data yang dikirim.",
            "type": "string"
          },
          "requestId": {
            "example": "ad7c22c2-8ed1-4df2-bb46-38bc930ecb67",
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "type": "object"
      },
      "ApiErrorEnvelopeDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "HealthReadinessDto": {
        "properties": {
          "service": {
            "enum": ["api"],
            "example": "api",
            "type": "string"
          },
          "status": {
            "enum": ["ready"],
            "example": "ready",
            "type": "string"
          }
        },
        "required": ["status", "service"],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Kontrak REST JSON untuk learner dan admin applications.",
    "title": "Interactive Digital Booklet Learning Platform API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadinessDto"
                }
              }
            },
            "description": "",
            "headers": {
              "X-Request-Id": {
                "description": "ID korelasi stabil untuk respons dan pelacakan dukungan.",
                "schema": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelopeDto"
                }
              }
            },
            "description": "Kegagalan internal tanpa kebocoran detail implementasi.",
            "headers": {
              "X-Request-Id": {
                "description": "ID korelasi yang sama dengan error.requestId.",
                "schema": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Readiness proses API",
        "tags": ["system"]
      }
    }
  },
  "servers": [],
  "tags": []
}
