# Documented local defaults for Docker Compose on 127.0.0.1 only.
# Copy this file to .env if local overrides are needed. Never place real,
# private, shared, staging, or production credentials in this file.

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flipbook
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flipbook?schema=public

# MinIO / Object Storage Configuration
# MinIO is approved only for local development under ADR-008.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=flipbook-assets
